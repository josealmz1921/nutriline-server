generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  NUTRITIONIST
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                  String               @id @default(uuid()) @db.Char(36)
  email               String               @unique @db.VarChar(254)
  passwordHash        String               @map("password_hash") @db.VarChar(255)
  role                UserRole
  status              UserStatus           @default(ACTIVE)
  createdAt           DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  nutritionistProfile  NutritionistProfile?
  sessions            AuthSession[]

  @@map("users")
}

model NutritionistProfile {
  id            String         @id @default(uuid()) @db.Char(36)
  userId        String         @unique @map("user_id") @db.Char(36)
  displayName   String         @map("display_name") @db.VarChar(150)
  timezone      String         @default("America/Mexico_City") @db.VarChar(64)
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  patients      Patient[]
  consultations Consultation[]

  @@map("nutritionist_profiles")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           String    @map("user_id") @db.Char(36)
  refreshTokenHash  String    @unique @map("refresh_token_hash") @db.Char(64)
  familyId         String    @map("family_id") @db.Char(36)
  expiresAt        DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt        DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("auth_sessions")
}

model Patient {
  id             String              @id @default(uuid()) @db.Char(36)
  nutritionistId String              @map("nutritionist_id") @db.Char(36)
  fullName       String              @map("full_name") @db.VarChar(150)
  birthDate      DateTime            @map("birth_date") @db.Date
  email          String?             @db.VarChar(254)
  phone          String?             @db.VarChar(32)
  occupation     String?             @db.VarChar(150)
  archivedAt     DateTime?           @map("archived_at") @db.DateTime(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  nutritionist   NutritionistProfile @relation(fields: [nutritionistId], references: [id], onDelete: Restrict)
  consultations  Consultation[]

  @@unique([id, nutritionistId])
  @@index([nutritionistId, archivedAt, fullName])
  @@map("patients")
}

model Consultation {
  id             String                     @id @default(uuid()) @db.Char(36)
  patientId      String                     @map("patient_id") @db.Char(36)
  nutritionistId String                     @map("nutritionist_id") @db.Char(36)
  occurredAt     DateTime                   @map("occurred_at") @db.DateTime(3)
  reason         String                     @db.VarChar(500)
  notes          String?                    @db.Text
  createdAt      DateTime                   @default(now()) @map("created_at") @db.DateTime(3)
  patient        Patient                    @relation(fields: [patientId, nutritionistId], references: [id, nutritionistId], onDelete: Restrict)
  nutritionist   NutritionistProfile         @relation(fields: [nutritionistId], references: [id], onDelete: Restrict)
  anthropometry  AnthropometricAssessment?
  calculations   CalculationResult[]

  @@index([patientId, occurredAt, id])
  @@index([nutritionistId, occurredAt])
  @@map("consultations")
}

model AnthropometricAssessment {
  id             String       @id @default(uuid()) @db.Char(36)
  consultationId String       @unique @map("consultation_id") @db.Char(36)
  measuredAt     DateTime     @map("measured_at") @db.DateTime(3)
  weightKg       Decimal      @map("weight_kg") @db.Decimal(8, 3)
  heightCm       Decimal      @map("height_cm") @db.Decimal(8, 3)
  waistCm        Decimal?     @map("waist_cm") @db.Decimal(8, 3)
  hipCm          Decimal?     @map("hip_cm") @db.Decimal(8, 3)
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Restrict)

  @@map("anthropometric_assessments")
}

model CalculationResult {
  id             String       @id @default(uuid()) @db.Char(36)
  consultationId String       @map("consultation_id") @db.Char(36)
  methodCode     String       @map("method_code") @db.VarChar(64)
  methodVersion  String       @map("method_version") @db.VarChar(16)
  inputs         Json
  value          Decimal      @db.Decimal(12, 6)
  unit           String       @db.VarChar(32)
  calculatedAt   DateTime     @default(now()) @map("calculated_at") @db.DateTime(3)
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Restrict)

  @@unique([consultationId, methodCode, methodVersion])
  @@map("calculation_results")
}
