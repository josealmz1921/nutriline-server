generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  NUTRITIONIST
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                  String               @id @default(uuid()) @db.Char(36)
  email               String               @unique @db.VarChar(254)
  passwordHash        String               @map("password_hash") @db.VarChar(255)
  role                UserRole
  status              UserStatus           @default(ACTIVE)
  createdAt           DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  nutritionistProfile  NutritionistProfile?
  sessions            AuthSession[]
  passwordResets      PasswordReset[]

  @@map("users")
}

model NutritionistProfile {
  id            String         @id @default(uuid()) @db.Char(36)
  userId        String         @unique @map("user_id") @db.Char(36)
  displayName   String         @map("display_name") @db.VarChar(150)
  timezone      String         @default("America/Mexico_City") @db.VarChar(64)
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  patients      Patient[]
  consultations Consultation[]
  menus         DailyMenu[]
  appointments  Appointment[]

  @@map("nutritionist_profiles")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           String    @map("user_id") @db.Char(36)
  refreshTokenHash  String    @unique @map("refresh_token_hash") @db.Char(64)
  familyId         String    @map("family_id") @db.Char(36)
  expiresAt        DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt        DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("auth_sessions")
}

model PasswordReset {
  id String @id @default(uuid()) @db.Char(36)
  userId String @map("user_id") @db.Char(36)
  tokenHash String @unique @map("token_hash") @db.Char(64)
  deliveryPayload String? @map("delivery_payload") @db.VarChar(512)
  deliveryAttempts Int @default(0) @map("delivery_attempts")
  lastDeliveryAttemptAt DateTime? @map("last_delivery_attempt_at") @db.DateTime(3)
  deliveredAt DateTime? @map("delivered_at") @db.DateTime(3)
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  usedAt DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  @@index([userId,createdAt])
  @@index([deliveredAt,expiresAt])
  @@map("password_resets")
}

model Patient {
  id             String              @id @default(uuid()) @db.Char(36)
  nutritionistId String              @map("nutritionist_id") @db.Char(36)
  fullName       String              @map("full_name") @db.VarChar(150)
  birthDate      DateTime            @map("birth_date") @db.Date
  email          String?             @db.VarChar(254)
  phone          String?             @db.VarChar(32)
  occupation     String?             @db.VarChar(150)
  gender         String?             @db.VarChar(16)
  nationality    String?             @db.Char(2)
  archivedAt     DateTime?           @map("archived_at") @db.DateTime(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  nutritionist   NutritionistProfile @relation(fields: [nutritionistId], references: [id], onDelete: Restrict)
  consultations  Consultation[]
  menus          DailyMenu[]
  appointments   Appointment[]

  @@unique([id, nutritionistId])
  @@index([nutritionistId, archivedAt, fullName])
  @@map("patients")
}

model Consultation {
  id                String                    @id @default(uuid()) @db.Char(36)
  patientId         String                    @map("patient_id") @db.Char(36)
  nutritionistId    String                    @map("nutritionist_id") @db.Char(36)
  occurredAt        DateTime                  @map("occurred_at") @db.DateTime(3)
  reason            String                    @db.VarChar(500)
  notes             String?                   @db.Text
  assessment        Json?
  assessmentVersion Int?                      @map("assessment_version")
  clientRequestId   String?                   @map("client_request_id") @db.Char(36)
  requestHash       String?                   @map("request_hash") @db.Char(64)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  patient           Patient                   @relation(fields: [patientId, nutritionistId], references: [id, nutritionistId], onDelete: Restrict)
  nutritionist      NutritionistProfile       @relation(fields: [nutritionistId], references: [id], onDelete: Restrict)
  anthropometry     AnthropometricAssessment?
  calculations      CalculationResult[]

  @@unique([nutritionistId, clientRequestId])
  @@index([patientId, occurredAt, id])
  @@index([nutritionistId, occurredAt])
  @@map("consultations")
}

model AnthropometricAssessment {
  id             String       @id @default(uuid()) @db.Char(36)
  consultationId String       @unique @map("consultation_id") @db.Char(36)
  measuredAt     DateTime     @map("measured_at") @db.DateTime(3)
  weightKg       Decimal      @map("weight_kg") @db.Decimal(8, 3)
  heightCm       Decimal      @map("height_cm") @db.Decimal(8, 3)
  waistCm        Decimal?     @map("waist_cm") @db.Decimal(8, 3)
  hipCm          Decimal?     @map("hip_cm") @db.Decimal(8, 3)
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Restrict)

  @@map("anthropometric_assessments")
}

model CalculationResult {
  id             String       @id @default(uuid()) @db.Char(36)
  consultationId String       @map("consultation_id") @db.Char(36)
  methodCode     String       @map("method_code") @db.VarChar(64)
  methodVersion  String       @map("method_version") @db.VarChar(16)
  inputs         Json
  value          Decimal      @db.Decimal(12, 6)
  unit           String       @db.VarChar(32)
  calculatedAt   DateTime     @default(now()) @map("calculated_at") @db.DateTime(3)
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Restrict)

  @@unique([consultationId, methodCode, methodVersion])
  @@map("calculation_results")
}

model DailyMenu {
  id             String              @id @default(uuid()) @db.Char(36)
  patientId      String              @map("patient_id") @db.Char(36)
  nutritionistId String              @map("nutritionist_id") @db.Char(36)
  date           DateTime            @db.Date
  revision       Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  patient        Patient             @relation(fields: [patientId, nutritionistId], references: [id, nutritionistId], onDelete: Restrict)
  nutritionist   NutritionistProfile @relation(fields: [nutritionistId], references: [id], onDelete: Restrict)
  revisions      DailyMenuRevision[]

  @@unique([id, nutritionistId])
  @@index([patientId, date, id])
  @@map("daily_menus")
}

model DailyMenuRevision {
  id                   String    @id @default(uuid()) @db.Char(36)
  menuId               String    @map("menu_id") @db.Char(36)
  nutritionistId       String    @map("nutritionist_id") @db.Char(36)
  revision             Int
  schemaVersion        Int       @default(1) @map("schema_version")
  capture              Json
  patientSnapshot      Json      @map("patient_snapshot")
  professionalSnapshot Json      @map("professional_snapshot")
  clientRequestId      String    @map("client_request_id") @db.Char(36)
  requestHash          String    @map("request_hash") @db.Char(64)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  menu                 DailyMenu @relation(fields: [menuId, nutritionistId], references: [id, nutritionistId], onDelete: Restrict)

  @@unique([menuId, revision])
  @@unique([nutritionistId, clientRequestId])
  @@map("daily_menu_revisions")
}

model Appointment {
  id String @id @default(uuid()) @db.Char(36)
  nutritionistId String @map("nutritionist_id") @db.Char(36)
  patientId String @map("patient_id") @db.Char(36)
  startsAt DateTime @map("starts_at") @db.DateTime(3)
  endsAt DateTime @map("ends_at") @db.DateTime(3)
  timeZone String @map("time_zone") @db.VarChar(64)
  localStartsAt String @map("local_starts_at") @db.VarChar(16)
  reason String @db.VarChar(500)
  notes String @db.VarChar(2000)
  status String @default("scheduled") @db.VarChar(16)
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  nutritionist NutritionistProfile @relation(fields:[nutritionistId],references:[id],onDelete:Restrict)
  patient Patient @relation(fields:[patientId,nutritionistId],references:[id,nutritionistId],onDelete:Restrict)
  mutations AppointmentMutation[]
  @@unique([id,nutritionistId])
  @@index([nutritionistId,status,startsAt,endsAt])
  @@index([patientId,startsAt,id])
  @@map("appointments")
}

model AppointmentMutation {
  id String @id @default(uuid()) @db.Char(36)
  appointmentId String @map("appointment_id") @db.Char(36)
  nutritionistId String @map("nutritionist_id") @db.Char(36)
  clientRequestId String @map("client_request_id") @db.Char(36)
  requestHash String @map("request_hash") @db.Char(64)
  version Int
  operation String @db.VarChar(16)
  response Json
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  appointment Appointment @relation(fields:[appointmentId,nutritionistId],references:[id,nutritionistId],onDelete:Restrict)
  @@unique([nutritionistId,clientRequestId])
  @@unique([appointmentId,version])
  @@map("appointment_mutations")
}
