# Solo desarrollo local. Cambiar todas las contraseñas fuera de este entorno.
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DEMO_MODE=true
# La telemetría permanece desactivada hasta revisar la privacidad.
OBSERVE_ENABLED=false
# Generar un valor propio con: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
AUTH_ACCESS_SECRET=replace-this-with-your-own-random-secret-at-least-48-characters
AUTH_ACCESS_TTL_SECONDS=300
AUTH_REFRESH_TTL_DAYS=7
# Solo para el seed sintético. No usar estas credenciales fuera de la demo local.
DEMO_PASSWORD=replace-with-a-local-demo-password
MYSQL_DATABASE=nutriline
MYSQL_USER=nutriline
MYSQL_PASSWORD=nutriline_local_development_password
MYSQL_ROOT_PASSWORD=nutriline_local_root_password
# Host db dentro de Compose. MySQL no se publica en la computadora.
DATABASE_URL=mysql://nutriline:nutriline_local_development_password@db:3306/nutriline
